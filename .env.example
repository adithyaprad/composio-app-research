# Copy to .env and fill in locally. Do not commit real keys.

# LLM: bedrock (default), anthropic, openai, or gemini
LLM_PROVIDER=bedrock
LLM_MODEL=global.anthropic.claude-sonnet-5-5
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Alternative providers (only needed if LLM_PROVIDER is not bedrock)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Used when the research agent calls Composio tools
# COMPOSIO_API_KEY=
