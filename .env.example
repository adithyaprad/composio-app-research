# Copy to .env and fill in locally. Do not commit real keys.
# Variables already set in the shell win over this file. Use ENV_FILE=/path/to/file
# to load a different file instead of the repo-root .env.

# ---- LLM -------------------------------------------------------------------
# bedrock (default) | anthropic | openai | gemini
LLM_PROVIDER=bedrock
# Any model id the provider accepts. Defaults per provider:
#   bedrock global.anthropic.claude-sonnet-5-5 | anthropic claude-sonnet-5-5
#   openai gpt-5.1 | gemini gemini-2.5-pro
LLM_MODEL=global.anthropic.claude-sonnet-5-5
# Output token cap per call (default 8000). A truncated answer gets one retry asking for a compact row.
# LLM_MAX_TOKENS=8000

# bedrock (Converse API). AWS_PROFILE also works instead of the two keys.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Only the key for the chosen provider is needed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional USD price per million tokens, used for est_cost_usd in log.jsonl.
# Leave unset to log token counts only.
# LLM_PRICE_IN_PER_MTOK=
# LLM_PRICE_OUT_PER_MTOK=

# ---- Search / fetch tools ----------------------------------------------------
# Exa API key (https://exa.ai). With it, search and fetch default to the direct Exa API, with free
# ddgs / http as the fallback. Without it, the agent uses the free tools only.
# (Composio Instant returned "400 No active connection" for its exa and firecrawl toolkits in this
# project, so Exa is called directly.)
# EXA_API_KEY=
# SEARCH_PROVIDER: exa (default with EXA_API_KEY: Exa /search, ddgs fallback) | ddgs (default without, free)
#                  | hybrid (ddgs; Composio Exa only when ddgs finds nothing)
#                  | auto / composio_exa / composio_tavily (Composio first, ddgs fallback)
# FETCH_PROVIDER:  exa (default with EXA_API_KEY: text from the search call or Exa /contents, http fallback)
#                  | hybrid (default without: free http first; a page goes to Composio Firecrawl only when it
#                  is thin or blocked by 401/403/429/503/network error) | auto / composio_firecrawl | http
# Composio is only used when COMPOSIO_API_KEY is set. After the first "No active connection" / 4xx it is
# switched off for the rest of the run (logged once) and the free result is kept.
SEARCH_PROVIDER=exa
FETCH_PROVIDER=exa

# Hard cap on Exa spend per run, in USD. 0 disables Exa calls. Each call reserves its listed price first
# ($0.007 per /search, $0.001 per /contents page); over the cap the free tool serves that call.
EXA_BUDGET_USD=5
# USE_COMPOSIO_EXA=false   # true = route search through Composio Exa first (same as SEARCH_PROVIDER=auto)

# Hard cap on Composio Instant spend per run, in USD. 0 disables Instant calls entirely.
# Every Instant call reserves its listed price first. Over the cap, the call is skipped and the free result is used.
INSTANT_BUDGET_USD=0.30
# Optional listed-price overrides (USD per call). Defaults: FIRECRAWL_SCRAPE=0.003, EXA_SEARCH=0.007,
# TAVILY_SEARCH=0.008, any other tool 0.01.
# INSTANT_PRICES=FIRECRAWL_SCRAPE=0.003,EXA_SEARCH=0.007
# ddgs backends tried in order (only yahoo returned results when this was written)
# DDGS_BACKENDS=yahoo,duckduckgo,bing,brave,google
# HTTP_TIMEOUT=20
# MAX_PAGE_CHARS=20000

# ---- Composio ------------------------------------------------------------------
# Used for Exa / Tavily / Firecrawl tool calls and scripts/composio_coverage.py.
# Without it, the agent uses only free ddgs + http.
# COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=composio-app-research

# ---- Browser Use (pass 3: python -m agent browse) ------------------------------
# Browser Use (open source) + Browser Use Cloud browsers for blocked pages. Pages open in a local headless
# Chromium (/usr/bin/google-chrome) first.
# Optional. Used only when a local Chromium page is blocked, shows a captcha, or comes back empty.
# Never required for the default local path. Do not commit a real key.
# BROWSER_USE_API_KEY=
