# Copy to .env and fill in locally. Do not commit real keys.
# Variables already set in the shell win over this file. Use ENV_FILE=/path/to/file
# to load a different file instead of the repo-root .env.

# ---- LLM -------------------------------------------------------------------
# bedrock (default) | anthropic | openai | gemini
LLM_PROVIDER=bedrock
# Any model id the provider accepts. Defaults per provider:
#   bedrock global.anthropic.claude-sonnet-5-5 | anthropic claude-sonnet-5-5
#   openai gpt-5.1 | gemini gemini-2.5-pro
LLM_MODEL=global.anthropic.claude-sonnet-5-5
# LLM_MAX_TOKENS=4096

# bedrock (Converse API). AWS_PROFILE also works instead of the two keys.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Only the key for the chosen provider is needed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional USD price per million tokens, used for est_cost_usd in log.jsonl.
# Leave unset to log token counts only.
# LLM_PRICE_IN_PER_MTOK=
# LLM_PRICE_OUT_PER_MTOK=

# ---- Search / fetch tools ----------------------------------------------------
# auto tries Composio first and falls back once per run to the keyless option.
# SEARCH_PROVIDER: auto | composio_exa | composio_tavily | ddgs
# FETCH_PROVIDER:  auto | composio_firecrawl | http
SEARCH_PROVIDER=auto
FETCH_PROVIDER=auto
# ddgs backends tried in order (only yahoo returned results when this was written)
# DDGS_BACKENDS=yahoo,duckduckgo,bing,brave,google
# HTTP_TIMEOUT=20
# MAX_PAGE_CHARS=20000

# ---- Composio ------------------------------------------------------------------
# Used for Exa / Tavily / Firecrawl tool calls and scripts/composio_coverage.py.
# Without it, auto mode uses ddgs + http directly.
# COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=composio-app-research
